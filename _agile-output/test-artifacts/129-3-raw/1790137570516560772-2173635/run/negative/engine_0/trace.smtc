initial
assume (= [bridge.ar_addr] #x0000)
assume (= [bridge.ar_full] false)
assume (= [bridge.aw_addr] #x0001)
assume (= [bridge.aw_full] false)
assume (= [bridge.b_error] #b00)
assume (= [bridge.b_full] true)
assume (= [bridge.exec] true)
assume (= [bridge.offer] true)
assume (= [bridge.offer_data] #x00000000)
assume (= [bridge.offer_strb] #x0)
assume (= [bridge.offer_write] false)
assume (= [bridge.owner] false)
assume (= [bridge.prefer_write] false)
assume (= [bridge.r_data] #x00000000)
assume (= [bridge.r_error] #b00)
assume (= [bridge.r_full] true)
assume (= [bridge.w_data] #x00000000)
assume (= [bridge.w_full] false)
assume (= [bridge.w_strb] #x0)
assume (= [decoder.busy] true)
assume (= [decoder.miss] true)
assume (= [decoder.owner] #b00)

state 0
assume (= [axi_s_axi_araddr] #x0000)
assume (= [axi_s_axi_arprot] #b000)
assume (= [axi_s_axi_arvalid] false)
assume (= [axi_s_axi_awaddr] #x0000)
assume (= [axi_s_axi_awprot] #b000)
assume (= [axi_s_axi_awvalid] false)
assume (= [axi_s_axi_bready] false)
assume (= [axi_s_axi_rready] false)
assume (= [axi_s_axi_wdata] #x00000000)
assume (= [axi_s_axi_wstrb] #x0)
assume (= [axi_s_axi_wvalid] true)
assume (= [clk] false)
assume (= [g_pad_in] #x00000000)
assume (= [rst] false)
assume (= [u_rx] false)
