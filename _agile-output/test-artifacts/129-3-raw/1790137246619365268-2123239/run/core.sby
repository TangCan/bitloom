[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 4
cover: mode cover
cover: depth 2

[engines]
smtbmc z3

[script]
read -formal design.v
hierarchy -top Fr198AxiCore
select -clear
blackbox Fr198Uart Fr198Gpio Fr198Timer Fr198Irq
setattr -mod -unset blackbox =A:blackbox=1
prep -top Fr198AxiCore

[files]
design.v
